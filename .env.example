# Copy to .env and fill in. Nothing here is read automatically -- these are environment
# variables the process expects, and .env is gitignored so real values never reach the repo.

# Bearer token for every endpoint except /health and /ready. Leave unset to run without
# authentication, which is only acceptable on 127.0.0.1: binding any other address without
# this set is refused at start-up. At least 16 characters.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
KB_API_TOKEN=

# Enables the Claude generator adapter. With no key the composition root binds the extractive
# generator instead and says so on /health -- the service is fully functional offline.
ANTHROPIC_API_KEY=

# Optional: override the model the Claude adapter asks for.
# CLAUDE_MODEL=claude-opus-5
